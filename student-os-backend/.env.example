# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentos?retryWrites=true&w=majority

# JWT issued by THIS backend after Firebase verification (not the Firebase token itself)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Firebase Admin SDK credentials ---
# Option A (recommended for hosting providers): paste the full service account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: individual fields (used only if FIREBASE_SERVICE_ACCOUNT is not set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Cloudinary (Notes & Resources file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Monthly upload cap for the Trusted Contributor role (Admins are unlimited).
# Falls back to 10 if unset.
MAX_MONTHLY_UPLOADS=10

# --- Google Gemini API (AI Learning Module) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for the current model
# list — names change as Google ships new versions. Falls back to
# gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Daily AI credits (shared across Explain / Summarize / Quiz). Falls back to
# 10 if unset.
DAILY_AI_CREDITS=10

# Safety net against rapid-fire AI requests (separate from daily credits).
# Falls back to 8 requests per 1 minute if unset.
AI_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MINUTES=1

# AI Study Assistant has its own, higher rate limit — a real chat session
# sends more requests than a one-shot Explain/Summarize/Quiz click. Falls
# back to 20 requests per 1 minute if unset.
AI_ASSISTANT_RATE_LIMIT_MAX=20
AI_ASSISTANT_RATE_LIMIT_WINDOW_MINUTES=1

# AI Study Assistant: how many of the most recent messages are sent to
# Gemini as conversation history (older messages stay stored and visible in
# the UI, just not re-sent). Falls back to 10 if unset.
AI_ASSISTANT_HISTORY_LIMIT=10

# AI Study Assistant: how many characters of a PDF's extracted text are
# sent as context per message. Falls back to 60000 if unset.
AI_ASSISTANT_CONTEXT_CHAR_LIMIT=60000

# Max characters accepted in a single AI Study Assistant message. Falls
# back to 4000 if unset.
MAX_ASSISTANT_MESSAGE_CHARS=4000

# Max characters accepted in a single AI Explain request. Falls back to
# 8000 if unset.
MAX_EXPLAIN_INPUT_CHARS=8000

# How many AI pre-generation jobs (Summary + Quiz, triggered right after a
# PDF upload) run at once in this process. Falls back to 2 if unset.
AI_PREGEN_CONCURRENCY=2
