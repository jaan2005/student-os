# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentos?retryWrites=true&w=majority

# JWT issued by THIS backend after Firebase verification (not the Firebase token itself)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Firebase Admin SDK credentials ---
# Option A (recommended for hosting providers): paste the full service account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: individual fields (used only if FIREBASE_SERVICE_ACCOUNT is not set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Cloudinary (Notes & Resources file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Monthly upload cap for the Trusted Contributor role (Admins are unlimited).
# Falls back to 10 if unset.
MAX_MONTHLY_UPLOADS=10
